# Terraform working directory
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Environment variables
.env
.env.*

# AWS / cloud credentials
.aws/

# SSH private keys
*.pem
*.key
id_rsa
id_ed25519

# Ansible retry files
*.retry

# Editor files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Terraform plan files
*.tfplan
tfplan
