        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "up{job=\"web-server\"}",
          "refId": "A"
        }
      ],
      "title": "Web Server Status",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{job=\"web-server\",mode=\"idle\"}[5m])) * 100)",
          "refId": "A"
        }
      ],
      "title": "CPU Usage",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"web-server\"} / node_memory_MemTotal_bytes{job=\"web-server\"}))",
          "refId": "A"
        }
      ],
      "title": "Memory Usage",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "targets": [
        {
          "expr": "100 * (1 - (node_filesystem_avail_bytes{job=\"web-server\",mountpoint=\"/\",fstype!=\"\"} / node_filesystem_size_bytes{job=\"web-server\",mountpoint=\"/\",fstype!=\"\"}))",
          "refId": "A"
        }
      ],
      "title": "Root Disk Usage",
